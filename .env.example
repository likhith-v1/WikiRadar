# Copy to .env and fill in. Never commit .env.

# Required by Wikimedia EventStreams (requests without it get 403/429)
WIKI_USER_AGENT=WikiRadar-DSA-MiniProject/1.0 (your-email@example.com)

# Kafka (broker runs in Docker, Python runs on the host)
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=wiki-edits
KAFKA_GROUP=wikiradar-processor

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wikiradar
POSTGRES_USER=wikiradar
POSTGRES_PASSWORD=change-me
